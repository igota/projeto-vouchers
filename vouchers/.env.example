DB_HOST=127.0.0.1
DB_NAME=vouchers_db

# Usuario de aplicacao (sem privilegios de root) — ver docker-compose.yml
# (MYSQL_USER/MYSQL_PASSWORD) para como o container cria esse usuario.
DB_USER=vouchers_app
DB_PASSWORD=changeme

# Senha do root do MySQL, só para administração do container.
DB_ROOT_PASSWORD=changeme

OMADA_USERNAME=changeme
OMADA_PASSWORD=changeme
# URL do Omada Controller, incluindo o ID do controller no path
OMADA_BASE_URL=https://192.168.1.10:8043/<omada-controller-id>
OMADA_SITE_ID=changeme

ICONTROL_USERNAME=changeme
ICONTROL_PASSWORD=changeme
ICONTROL_BASE_URL=https://192.168.1.20:8889

# URL base do sistema Vitae/NTI usado para validar login de /gerencia
VITAE_URL=https://vitae.example.com

# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
KIOSK_API_KEY=changeme

FLASK_DEBUG=false

ALLOWED_ORIGINS=http://192.168.1.10:5173,http://localhost:5173

TIPOS_USUARIO_PERMITIDO=TÉCNICO EM INFORMÁTICA

# Horario dos jobs de reposicao/limpeza: ver deploy/scheduler/entrypoint.sh

IMPRESSORA_REDE_HABILITADA=true
IMPRESSORA_REDE_IP=192.168.1.30

ESTOQUE_LIMITE_MAXIMO=10
ESTOQUE_LIMITE_MINIMO=5
VOUCHER_REPOSICAO_DURACAO_MINUTOS=1440
