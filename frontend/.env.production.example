# Usado por `npm run build` (Vite carrega .env.production automaticamente).
#
# Em produção o Nginx serve o build estático e faz proxy de /api e /gerencia
# para o Gunicorn na mesma origem (ver deploy/nginx/vouchers.conf) — por isso
# VITE_API_BASE fica vazio (caminho relativo), diferente do .env de dev.
VITE_API_BASE=
VITE_KIOSK_API_KEY=changeme
